# ETAP 5 — Evil Twin 601A z DHCP (poprawny)
## Komendy
hostapd -B /tmp/evil601a.conf (SSID=601A, WPA2-PSK, kanal 4)
dnsmasq --interface=wlan0 --dhcp-range=192.168.200.50,192.168.200.150,12h
